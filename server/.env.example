# Maya gateway config — copy to server/.env and fill in.
#   set -a; source server/.env; set +a; node server/gateway.js
# Keys stay on this server. Never prefix them with VITE_.

# --- Brain: Google Gemini (free key from aistudio.google.com → Get API key) ---
UPSTREAM_BASE=https://generativelanguage.googleapis.com/v1beta/openai
UPSTREAM_KEY=AIzaSy_paste_yours_here
UPSTREAM_MODEL=gemini-3.6-flash

# --- Failover spare (optional but recommended): free Groq tier at console.groq.com
# When Gemini throttles, traffic rolls here automatically, then to a keyless
# public fallback. No app changes needed.
# UPSTREAM2_BASE=https://api.groq.com/openai/v1
# UPSTREAM2_KEY=gsk_paste_yours_here
# UPSTREAM2_MODEL=llama-3.3-70b-versatile

PORT=8787
SERVE_DIR=./dist
DATA_DIR=./data

# --- Voice: ElevenLabs lifelike voice (free tier at elevenlabs.io; optional) ---
# ELEVENLABS_API_KEY=xi_paste_yours_here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Rachel (natural female); pick others from Voice Library
# ELEVENLABS_MODEL=eleven_multilingual_v2
# GATEWAY_TOKEN=any-random-string          # + matching VITE_GATEWAY_TOKEN at frontend build
# ALLOWED_ORIGIN=https://your-domain
# USERS="alice:pw1,bob:pw2"                # multi-user login (home-grade plaintext)
#   (or: node server/add-user.js <name> <pw> for scrypt-hashed file accounts)

# --- Storage: Supabase Postgres (replaces local sqlite/JSON) ---
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_ANON_KEY=eyJ...anon...
# SUPABASE_SERVICE_KEY=eyJ...service-role...   # server only, never VITE_
