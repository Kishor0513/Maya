# Maya environment — copy to .env and fill in.
# Never put privileged provider keys here. All secrets live server-side.

# Backend gateway (REST + memory + chat proxy). Frontend calls this, never the provider directly.
VITE_API_URL=http://localhost:8787
# Realtime gateway (WebSocket, optional — chat + voice work without it).
# VITE_REALTIME_URL=ws://localhost:8787/api/realtime
