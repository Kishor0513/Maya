# Maya environment — copy to .env and fill in.
# Never put privileged provider keys here. All secrets live server-side.

# Backend gateway (REST + memory + chat proxy). Frontend calls this, never the provider directly.
VITE_API_URL=http://localhost:8787
# Realtime gateway (WebSocket, optional — chat + voice work without it).
# VITE_REALTIME_URL=ws://localhost:8787/api/realtime

# --- Vercel + Supabase cloud (no local gateway) ---
# Bake these at build time; the app then uses Supabase Auth + Edge Functions.
# VITE_API_URL=https://<ref>.supabase.co/functions/v1
# VITE_SUPABASE_URL=https://<ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...anon...
# Hybrid computer control: local gateway URL the app falls back to when the
# cloud backend answers computer-local-only (defaults to localhost:8787).
# VITE_LOCAL_URL=http://localhost:8787
